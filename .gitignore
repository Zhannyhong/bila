# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated scenes (contain absolute paths; regenerate with shelf_scene.py)
scenes/

# IDE settings (per developer)
.idea/

# macOS, and iCloud Drive placeholders for offloaded files
.DS_Store
*.icloud
.vscode/
debug_outputs/
.pytest_cache/
generated_assets

# MuJoCo writes its warnings here
MUJOCO_LOG.TXT

# Residual training runs (train_residual.py): checkpoints and logs
runs/

# Reruns of the report's experiments (the recorded rows are in results/paper/ and results/)
results/slide_check/

# Trained weights (published as the weights-v1 GitHub release, too big for git)
bila_weights/
bila_weights.zip

# LaTeX build files
out/
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz
